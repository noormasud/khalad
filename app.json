{
  "expo": {
    "name": "Khalad",
    "slug": "khalad",
    "scheme": "khalad",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#0E0E0E"
      }
    },
    "android": {
      "package": "com.islamicapp.khalad",
      "versionCode": 101,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E0E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.islamicapp.khalad",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Khalad uses your location on this phone only, to calculate prayer times and the Qibla direction. It is never stored or shared."
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Khalad uses your location on this phone only, to calculate prayer times and the Qibla direction. It is never stored or shared.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B7F47",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.reactnativeandroidwidget.** { *; }\n-keep class com.islamicapp.khalad.widget.** { *; }"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextPrayer",
              "label": "Next prayer",
              "description": "The next prayer time, quietly. No countdown.",
              "previewImage": "./assets/widget-preview/prayer.png",
              "minWidth": "150dp",
              "minHeight": "70dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "HadithOfDay",
              "label": "Hadith of the day",
              "description": "One verified hadith or sunnah, new each day",
              "previewImage": "./assets/widget-preview/hadith.png",
              "minWidth": "150dp",
              "minHeight": "150dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayReading",
              "label": "Today’s reading",
              "description": "Your daily goal, where to continue, and your streak",
              "previewImage": "./assets/widget-preview/reading.png",
              "minWidth": "150dp",
              "minHeight": "150dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "3f682cc8-9421-4f23-ad1a-51f2efb2ab8b"
      },
      "router": {}
    },
    "owner": "khaladtheapp"
  }
}
